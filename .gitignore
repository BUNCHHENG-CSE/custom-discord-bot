# ==============================================================================
# .gitignore for DiscordBot
# ==============================================================================

# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.conf
# lavalink/application.yml holds a real YouTube OAuth refresh token
lavalink/application.yml
!lavalink/application.example.yml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Runtime artifacts ---
*.log
logs/
.bot-instance.lock
*.pid

# --- Local databases ---
*.sqlite
*.sqlite3
*.db

# --- Build outputs, toolchains & deploy bundles ---
lavalink-build/
toolchain/
*.zip
*.tar.gz

# --- Large binaries ---
# Lavalink.jar (~95 MB) is near GitHub's 100 MB hard limit. To stop tracking it,
# uncomment these and run: git rm --cached lavalink/Lavalink.jar lavalink/plugins/*.jar
# lavalink/Lavalink.jar
# lavalink/plugins/*.jar

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
